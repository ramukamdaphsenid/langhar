# ==============================================================================
# Tally Prime Configuration
# ==============================================================================
# Tally Prime XML HTTP Server (Ensure Tally is open and Server mode is enabled)
# Help -> Settings -> Connectivity -> Client/Server configuration -> Both/Server
TALLY_HOST=http://localhost
TALLY_PORT=9000
TALLY_TIMEOUT=30

# Optional: Specific Company Name in Tally (Leave blank to use currently active company)
TALLY_COMPANY=

# Optional ODBC Settings (if you specifically use Tally ODBC DSN instead of XML API)
TALLY_USE_ODBC=false
TALLY_ODBC_DSN=TallyODBC64_9000

# ==============================================================================
# Firebase Firestore Configuration
# ==============================================================================
# Path to your Firebase service account JSON key file
# Download from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Target Firestore collection where vouchers will be stored
FIREBASE_COLLECTION_NAME=sales_vouchers

# ==============================================================================
# Sync & Scheduler Configuration
# ==============================================================================
# How often to check for new/modified vouchers in daemon mode (in seconds)
SYNC_INTERVAL_SECONDS=120

# Path to state file tracking last sync time and altered IDs
SYNC_STATE_FILE=.sync_state.json

# Batch size when committing records to Firestore (max allowed by Firestore is 500)
BATCH_SIZE=100
