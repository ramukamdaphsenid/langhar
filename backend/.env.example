# ==============================================================================
# Tally Prime Configuration
# ==============================================================================
# Tally Prime XML HTTP Server (Ensure Tally is open and Server mode is enabled)
# Help -> Settings -> Connectivity -> Client/Server configuration -> Both/Server
TALLY_HOST=http://localhost
TALLY_PORT=9000
TALLY_TIMEOUT=30

# Keep the intended company active in Tally. The app reads vouchers directly
# from this company and verifies the active company before and after each query.

# Optional ODBC verification for the active company. XML is still required for full voucher data.
TALLY_USE_ODBC=false
TALLY_ODBC_DSN=TallyODBC64_9000

# ==============================================================================
# Local Web Server Configuration
# ==============================================================================
# Address and port used by the packaged Langhar application. If the port is
# already in use, the next free port is selected automatically.
# Use 0.0.0.0 only to expose the app to other devices on your network.
APP_HOST=127.0.0.1
APP_PORT=8000

# ==============================================================================
# SPA Static Files Configuration
# ==============================================================================
# Override the directory where the compiled Angular SPA is served from.
# Defaults to backend/static for local backend development.
# STATIC_DIR=/path/to/angular/dist
